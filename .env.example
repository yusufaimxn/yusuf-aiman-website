# Resend server-side email delivery.
# Create this key in the Resend dashboard. Never expose it with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_api_key_here

# Recipient and verified sender for portfolio enquiries.
CONTACT_EMAIL_TO=myusufaiman05@gmail.com
CONTACT_EMAIL_FROM=Yusuf Aiman Portfolio <contact@yusufaiman.me>

# Optional visitor acknowledgement. Enable only after the sender domain is verified.
CONTACT_SEND_CONFIRMATION=false

# Persistent rate limiting through Upstash Redis.
# Required in production so the API does not rely on in-memory state.
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
